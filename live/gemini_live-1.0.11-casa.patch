+_CASA_ES_WORDS = {"yo", "lo", "la", "los", "las", "el", "que", "pero", "para", "por", "porque", "una", "es", "esta", "estoy",
+                  "eres", "soy", "somos", "tengo", "tiene", "tienes", "quiero", "quieres", "vamos", "vale", "bueno", "mira",
+                  "oye", "eso", "esto", "esa", "ese", "aqui", "ahi", "alli", "ahora", "luego", "tambien", "nada", "todo",
+                  "muy", "mas", "cojo", "coge", "sabes", "creo", "dice", "digo", "hay", "hace", "hacer", "como", "cuando",
+                  "donde", "nos", "les", "mi", "su", "del", "pues", "entonces", "gracias", "hola", "venga", "claro",
