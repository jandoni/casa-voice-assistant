 _LOGGER = logging.getLogger(__name__)
+# CASA PATCH (2026-11-01): transcript of a turn in which nothing usable was heard; conversation.py ends it silently
+CASA_SILENT = "…"
+# CASA PATCH (2026-11-02): the Echo's stream starts while "Alexa" is still being said. Its last ~0.3 s followed by the
+# pause before the question looked like a finished utterance to Gemini's end-of-speech: it answered "…xa" as the
+# question began and the turn was closed mid-sentence.
+# The first CASA_LEAD_BYTES are held back; speech that stops before CASA_TAIL_MAX_S and is followed by a quiet gap
+# (>= 240 ms) is the wake word's tail -> replaced with silence. A command said in one breath (no gap) is sent as is.
+CASA_LEAD_BYTES = 25600   # 0.8 s of 16 kHz PCM16 (sent in one go once collected: no delay at the end of the question)
+CASA_TAIL_MAX_S = 0.5
 
+
+def _casa_strip_wake_tail(pcm: bytes) -> bytes:
+    try:
+        import numpy as np
+
+        x = np.frombuffer(pcm[: len(pcm) // 2 * 2], np.int16).astype(np.float32) / 32768
+        if len(x) < 6400:
+            return pcm
+        spec = np.fft.rfft(x)
+        spec[: int(90 * len(x) / 16000)] = 0          # raw mic: DC + rumble
+        y = np.fft.irfft(spec, len(x))
+        n = len(y) // 320                               # 20 ms frames
+        db = 20 * np.log10(np.sqrt((y[: n * 320].reshape(n, 320) ** 2).mean(1)) + 1e-9)
+        run, start = 0, None
+        for i in range(n):
+            run = run + 1 if db[i] < -55 else 0
+            if run >= 12:
+                start = i - 11
+                break
+        if start is None or start * 0.02 > CASA_TAIL_MAX_S or not (db[:start] > -45).any():
+            return pcm
+        out = bytearray(pcm)
+        out[: start * 640] = bytes(start * 640)
+        _LOGGER.warning("CASA: silenced the wake word's tail (first %.2f s) before the question", start * 0.02)
+        return bytes(out)
+    except Exception:  # noqa: BLE001 - never break a voice turn
+        return pcm
+
