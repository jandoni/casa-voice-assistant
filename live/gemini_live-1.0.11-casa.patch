+_CASA_TURNS: dict[str, int] = {}
+
+
+def _casa_count_turn(conversation_id: str) -> int:
+    if len(_CASA_TURNS) > 200:
+        _CASA_TURNS.clear()
+    _CASA_TURNS[conversation_id] = _CASA_TURNS.get(conversation_id, 0) + 1
+    return _CASA_TURNS[conversation_id]
+
+
+_CASA_TV_ENTITY = "media_player.living_room_tv"   # the TV whose dialogue reaches the Echos
+_CASA_SOUNDBAR_ENTITY = "media_player.soundbar"     # a soundbar whose "TV" source also counts as the TV playing
+
+
+def _casa_tv_on(hass) -> bool:
+    atv = hass.states.get(_CASA_TV_ENTITY)
+    bar = hass.states.get(_CASA_SOUNDBAR_ENTITY)
+    return bool((atv and atv.state == "playing") or
+                (bar and bar.state == "playing" and str(bar.attributes.get("source", "")).upper() == "TV"))
