# Copy to config.env (gitignored) and fill in. The scripts read it from the environment:
#   set -a; . ./config.env; set +a
HA_URL=http://<ha host>:8123
HA_TOKEN=<long-lived access token>

# ssh target of the HA OS host (benchmarks switch the Whisper / Piper add-ons through the Supervisor API)
HA_SSH=root@<ha host>

# Ollama on the voice host (ollama-guard listens on :11435 in front of it)
OLLAMA_URL=http://<voice host>:11434

# Assist pipeline id of "Casa AI" (ai-eval/ha_ws.py '{"type": "assist_pipeline/pipeline/list"}')
CASA_PIPELINE_ID=<pipeline id>

# live/setup_gemini_live.py: room=VACA device id (the <id> in select.vaca_<id>_assistant)
CASA_ECHOS=office=<vaca id>,bedroom=<vaca id>,living=<vaca id>
# optional: the setup script can create the Gemini Live entry with this key; or add the integration by hand in HA
GEMINI_API_KEY=<google ai studio key, paid project>

# claude/apply_voice_prompt.py: the Anthropic integration entry and its conversation subentry
CLAUDE_ENTRY_ID=<config entry id>
CLAUDE_SUBENTRY_ID=<subentry id>

# voice-lab/run_lab.py
VOICELAB_ROOMS={"office": ["assist_satellite.vaca_<id>", "media_player.<speaker next to the echo>", "<id>", "clips.json"]}
