+    def _casa_bogus_who(self, text: str, result) -> bool:
+        """A 'who is <X>' presence query with no answer where <X> is not one of the house's zones."""
+        m = _re.match(r"^\s*who(?:'s| is| was| are)\s+(?:in |at )?(?:the )?(.+?)[?.!]*\s*$", text or "", _re.I)
+        if not m:
+            return False
+        try:
+            resp = result.response
+            if resp.response_type != intent.IntentResponseType.QUERY_ANSWER:
+                return False
+            if resp.success_results or resp.failed_results:
+                return False
+        except Exception:  # noqa: BLE001
+            return False
+        what = m.group(1).strip().lower()
+        zones = {"home", "away", "not home", "out", "work"}
+        for st in self.hass.states.async_all("zone"):
+            zones.add((st.name or "").lower()); zones.add(st.object_id.replace("_", " ").lower())
+        return what not in zones
