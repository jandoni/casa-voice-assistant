+    async def _casa_run_cancellable(self, user_input: ConversationInput) -> ConversationResult:
+        """Run the request, but abort it (task cancel -> the LLM HTTP call is dropped too) when the dashboard's X
+        fires `casa_voice_cancel`, or after CASA_TIMEOUT_S."""
+        stop = asyncio.Event()
 
+        @callback
+        def _on_cancel(_event) -> None:
+            stop.set()
+
+        unsub = self.hass.bus.async_listen("casa_voice_cancel", _on_cancel)
+        work = asyncio.ensure_future(self._async_process_with_runtime(user_input))
+        waiter = asyncio.ensure_future(stop.wait())
+        try:
+            done, _ = await asyncio.wait({work, waiter}, timeout=CASA_TIMEOUT_S, return_when=asyncio.FIRST_COMPLETED)
+            if work in done:
+                return work.result()
+            work.cancel()
+            with contextlib.suppress(BaseException):
+                await work
+            if waiter in done:
+                raise _CasaCancelled
+            raise asyncio.TimeoutError
+        finally:
+            unsub()
+            waiter.cancel()
