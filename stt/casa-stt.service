[Unit]
Description=casa-stt - two-stage Wyoming speech-to-text (Kroko streaming + Parakeet TDT)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/casa-stt
EnvironmentFile=/opt/casa-stt/casa-stt.env
ExecStart=/opt/casa-stt/venv/bin/python /opt/casa-stt/casa_stt.py
Restart=always
RestartSec=5
Nice=-5

[Install]
WantedBy=multi-user.target
