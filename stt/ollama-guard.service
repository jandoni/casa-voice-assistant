[Unit]
Description=ollama-guard - Ollama proxy that caps num_predict for Home Assistant (:11435 -> :11434)
After=network-online.target ollama.service

[Service]
Type=simple
ExecStart=/opt/casa-stt/venv/bin/python /opt/casa-stt/ollama_guard.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
