[Unit]
Description=whisper.cpp SMALL on the Arc iGPU (Vulkan) - fast stage-2 STT for questions (casa-stt)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/whisper.cpp
EnvironmentFile=-/opt/casa-stt/whisper.env
ExecStart=/opt/whisper.cpp/build/bin/whisper-server -m /opt/whisper.cpp/models/ggml-small-q5_1.bin -l en -bs 1 -ac 512 -nf -sns -t 4 --host 127.0.0.1 --port 10322 --prompt "${WHISPER_PROMPT}"
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
