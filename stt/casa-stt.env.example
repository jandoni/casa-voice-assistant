# /opt/casa-stt/casa-stt.env on the voice host (EnvironmentFile of casa-stt, read by wake_verify.py too). Never commit it.
HA_URL=http://<ha host>:8123
HA_TOKEN=<long-lived access token>

# casa-stt tunables (defaults in casa_stt.py)
CASA_STT_HOTWORDS=/opt/casa-stt/hotwords.txt
CASA_STT_HOTWORDS_SCORE=2.0
CASA_STT_BEAM=4
CASA_STT_STREAM_THREADS=4
CASA_STT_OFFLINE_THREADS=8
# stage 2: whisper (whisper.cpp server, default) | parakeet (sherpa-onnx, CPU) | hybrid (Parakeet first, whisper on disagreement)
CASA_STT_OFFLINE_ENGINE=whisper
CASA_STT_WHISPER_URL=http://127.0.0.1:10320/inference
CASA_STT_WHISPER_FAST_URL=http://127.0.0.1:10322/inference
CASA_STT_WHISPER_TIMEOUT=9
# keep the last N utterances as WAV for debugging (empty = off). These are recordings of your home: keep them local.
CASA_STT_RECORD_DIR=
CASA_STT_RECORD_KEEP=300

# wake verifier
# each Echo by the address it posts from: <ip>=<room>,<ip>=<room>
CASA_WAKE_ROOMS=<echo ip>=office,<echo ip>=bedroom,<echo ip>=living
# the TV whose dialogue wakes the Echos, an optional soundbar (its "TV" source counts as the TV playing), and the rooms
# that only hear the TV through the walls (they need a very confident wake while it plays)
CASA_TV_ENTITY=media_player.<tv>
CASA_SOUNDBAR_ENTITY=media_player.<soundbar>
CASA_TV_GUARD_ROOMS=office,bedroom
